          }
        }
      }
    },
    "social.visit.note": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeder Freund freut sich einmal am Tag über deinen Besuch."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Each friend is happy to see you once a day."
          }
        }
