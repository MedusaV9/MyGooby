    "social.npc.luna.story.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna und Gooby haben sich den wärmsten Sonnenfleck auf der Fensterbank geteilt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna and Gooby shared the warmest patch of sun on the windowsill."
          }
        }
      }
    },
    "social.npc.luna.story.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna hat Gooby beigebracht, sich ganz lang zu strecken. Danach waren beide wach und froh."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna taught Gooby a really long stretch. Afterwards both felt awake and happy."
          }
        }
      }
    },
    "social.npc.luna.story.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden haben ein Wollknäuel quer durch das Zimmer gerollt und viel gelacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two of them rolled a ball of yarn across the room and laughed a lot."
          }
        }
      }
    },
    "social.npc.luna.story.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna hat geschnurrt, bis Gooby ganz ruhig geatmet hat."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna purred until Gooby was breathing slow and calm."
          }
        }
      }
    },
    "social.npc.luna.story.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna hat Gooby die Sterne gezeigt, die man nur von ihrem Dach aus sieht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna showed Gooby the stars you can only see from her roof."
          }
        }
      }
    },
    "social.npc.luna.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna, die Katze"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Luna the cat"
          }
        }
      }
    },
    "social.npc.luna.welcome": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Miau! Ich habe von deinem ersten Abenteuer gehört. Ich bin Luna und kenne die gemütlichsten Sonnenplätze."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Meow! I heard about your first adventure. I'm Luna and I know all the coziest sunny spots."
          }
        }
      }
    },
    "social.npc.momo.story.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo und Gooby haben Honigtee getrunken und den Wolken Namen gegeben."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo and Gooby sipped honey tea and gave the clouds names."
          }
        }
      }
    },
    "social.npc.momo.story.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo hat Gooby gezeigt, wo die süßesten Beeren wachsen. Ein paar sind sogar im Korb gelandet."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo showed Gooby where the sweetest berries grow. A few even made it into the basket."
          }
        }
      }
    },
    "social.npc.momo.story.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden haben sich unter den Baum gekuschelt und dem Regen zugehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two of them snuggled under the tree and listened to the rain."
          }
        }
      }
    },
    "social.npc.momo.story.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo hat gebrummt, Gooby hat gesummt. Zusammen klang es fast wie ein Lied."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo hummed low, Gooby hummed high. Together it almost sounded like a song."
          }
        }
      }
    },
    "social.npc.momo.story.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo hat erzählt, dass kleine Pausen auch Mut brauchen. Gooby hat genickt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo said that small breaks take courage too. Gooby nodded."
          }
        }
      }
    },
    "social.npc.momo.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo, der kleine Bär"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Momo the little bear"
          }
        }
      }
    },
    "social.npc.momo.welcome": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hallo! Ich bin Momo und wohne gleich hinter dem großen Baum. Komm mich besuchen, ich teile gern meinen Honigtee."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hi! I'm Momo and I live right behind the big tree. Come visit me, I love sharing my honey tea."
          }
        }
      }
    },
    "social.npc.nini.story.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini und Gooby haben Gänseblümchen gezählt. Bei siebenundzwanzig haben sie aufgehört und gekichert."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini and Gooby counted daisies. At twenty-seven they stopped and giggled."
          }
        }
      }
    },
    "social.npc.nini.story.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini hat Gooby ihr neues Lied vorgepiepst. Gooby hat dazu geklatscht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini cheeped her new song for Gooby. Gooby clapped along."
          }
        }
      }
    },
    "social.npc.nini.story.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden haben in einer Pfütze den Himmel angeschaut."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two of them looked at the sky in a puddle."
          }
        }
      }
    },
    "social.npc.nini.story.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini hat Gooby erzählt, dass man auch mit kleinen Flügeln weit kommt."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini told Gooby that small wings can still take you far."
          }
        }
      }
    },
    "social.npc.nini.story.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini und Gooby haben ein Nest aus Blättern gebaut und darin ein Nickerchen gemacht."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini and Gooby built a nest of leaves and took a nap in it."
          }
        }
      }
    },
    "social.npc.nini.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini, das Küken"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Nini the chick"
          }
        }
      }
    },
    "social.npc.nini.welcome": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Piep piep! Ich bin Nini. Ich habe so lange gewartet, bis du hier vorbeikommst. Wollen wir Freunde sein?"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Cheep cheep! I'm Nini. I waited so long for you to come by. Shall we be friends?"
          }
        }
      }
    },
    "social.npc.pino.story.0": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino und Gooby haben eine Schatzkarte gemalt. Der Schatz war am Ende ein besonders schöner Stein."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino and Gooby drew a treasure map. The treasure turned out to be a very pretty pebble."
          }
        }
      }
    },
    "social.npc.pino.story.1": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino hat Gooby ein Versteck im hohen Gras gezeigt, perfekt zum Ausruhen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino showed Gooby a hideout in the tall grass, perfect for a rest."
          }
        }
      }
    },
    "social.npc.pino.story.2": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die beiden sind um die Wette gehüpft. Gewonnen haben beide."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The two of them had a hopping race. Both of them won."
          }
        }
      }
    },
    "social.npc.pino.story.3": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino hat von seinem längsten Ausflug erzählt und Gooby hat staunend zugehört."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino told the story of his longest trip and Gooby listened in awe."
          }
        }
      }
    },
    "social.npc.pino.story.4": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino hat Gooby gezeigt, wie man Pläne macht, die auch mal schiefgehen dürfen."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino showed Gooby how to make plans that are allowed to go wrong sometimes."
          }
        }
      }
    },
    "social.npc.pino.title": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino, der Fuchs"
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Pino the fox"
          }
        }
      }
    },
    "social.npc.pino.welcome": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, Abenteurer! Ich bin Pino. Drei Reisen schon? Dann lass uns Karten tauschen und Pläne schmieden."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Hey, adventurer! I'm Pino. Three trips already? Let's swap maps and make plans."
          }
        }
      }
    },
    "social.outfit.name": {
