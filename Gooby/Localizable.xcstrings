    "menu.privacy.backup": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die internen Spieldaten sind vom iCloud-Backup ausgeschlossen. Wechselst du das iPhone oder löschst du die App, sind sie weg, außer du hast vorher unter „Deine Daten“ einen Export gesichert. Ein Export liegt nur dort, wo du ihn selbst ablegst."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "The internal save data is excluded from iCloud backup. If you switch iPhones or delete the app, it is gone unless you saved an export under \"Your data\" first. An export lives only where you put it yourself."
          }
        }
      }
    },
    "menu.privacy.body": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooby funktioniert komplett offline. Es gibt kein Konto, keinen Server, keine Werbung und keine Analyse. Alle Daten bleiben auf diesem iPhone."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "Gooby works fully offline. There is no account, no server, no ads and no analytics. All data stays on this iPhone."
          }
        }
      }
    },
    "menu.privacy.sub": {
      "extractionState": "manual",
