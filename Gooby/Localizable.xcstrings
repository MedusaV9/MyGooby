    "calm.disclaimer": {
      "extractionState": "manual",
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Das sind kleine Achtsamkeits- und Bewegungsübungen zum Selbstgebrauch. Sie stellen keine Diagnose, versprechen keine Therapie und ersetzen keine professionelle Hilfe."
          }
        },
        "en": {
          "stringUnit": {
            "state": "translated",
            "value": "These are small mindfulness and movement exercises for personal use. They are not a diagnosis, do not promise therapy, and do not replace professional help."
          }
        }
      }
    },
